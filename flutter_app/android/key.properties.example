# Template para key.properties
# Copia este archivo a key.properties y completa los valores
# key.properties ya está en .gitignore para mantener tus credenciales seguras

# Para crear un keystore nuevo, ejecuta:
# keytool -genkey -v -keystore ~/upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload

# Ruta al archivo keystore (relativa a flutter_app/android/)
storeFile=upload-keystore.jks

# Contraseña del keystore
storePassword=tu_contraseña_keystore

# Alias de la clave
keyAlias=upload

# Contraseña de la clave
keyPassword=tu_contraseña_clave
