{
  "info": {
    "name": "CronoApp API",
    "description": "Colección de endpoints para la API de Cronogramas de Pago",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health"
      }
    },
    {
      "name": "AUTH",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success) pm.collectionVariables.set('token', res.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}"
            }
          }
        },
        {
          "name": "Me (perfil)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "CRONOGRAMA",
      "item": [
        {
          "name": "Generar cronograma",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/cronograma/generar",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"F00000002\",\n  \"tipodoc\": \"F\",\n  \"nroCuotas\": 6\n}"
            }
          }
        },
        {
          "name": "Consultar cronograma",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/cronograma/F00000001/F",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Historial",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/cronograma/historial?page=1&pageSize=20",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Validar documento",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/cronograma/documento/validar",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"B00000001\",\n  \"tipodoc\": \"B\"\n}"
            }
          }
        },
        {
          "name": "Obtener parámetros",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/parametros",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    }
  ]
}
